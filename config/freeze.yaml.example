# Freeze the lab environment. Copy to freeze.yaml and fill in the exact models running in your stack.
frozen_at: "2026-11-07"
upstream:
  auto_ontology:
    repo: https://github.com/NVIDIA/auto-ontology
    commit: c447003f72a822301e927196a4ecb5b597c308d5
    version: "1.2.0"
    alembic_head: 99d4d343dd0b
  auto_ontology_eval:
    repo: https://github.com/NVIDIA/auto-ontology-eval
    commit: ec41b2c5b795637759297b90c1d19b42693200f9
    pins_auto_ontology_commit: dd78d0689ef9a8e062af90a294fa903cb6643015   # DIFFERS from stack commit — see UPSTREAM_ARCHITECTURE.md §6
    nemo_gym: "0.7.0"
models:   # Every role must be explicitly specified; EMBED must match between ingestion and backend
  reasoning:     {endpoint: "", model: ""}
  non_reasoning: {endpoint: "", model: ""}
  embed:         {endpoint: "", model: ""}
  rerank:        {endpoint: "", model: ""}   # Unused during query answering; used only during compilation
  gym_control:   {endpoint: "", model: ""}   # Must equal reasoning model for a fair comparison
flags:
  semantic_compilation_enabled: true
  pii_detection_enabled: true
  distinct_value_probing_enabled: true
  sql_query_timeout_seconds: 30
  INTERACTIVE: false
  DB_PROBE_PROACTIVE: false
  DB_PROBE_JOIN_PATH_CHECK: false
  LLM_MAX_INFLIGHT: 6
endpoints:
  gateway: http://localhost:3000        # Only production entrypoint for lab clients
  ingestion_internal: http://localhost:3002   # ONLY used in Suite 4 (/ingest, /semantic/reset, /semantic/status)
# container_name values from docker-compose.yml, not the compose service names
containers: {postgres: postgres, backend: auto-ontology, ingestion: auto-ontology-ingestion-service, frontend: auto-ontology-frontend}
catalog: {database: auto_ontology, superuser: postgres}
