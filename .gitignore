# Local generated datasets (never publish to Git)
/datasets/*
!/datasets/.gitkeep
!/datasets/edu-public/

# Catalog snapshots can hold live connection credentials; raw run artefacts stay local
/snapshots/
/reports/runs/

# Environment variables & API keys
.env
.env.*
!.env.example
auto-ontology/.env
auto-ontology/.env.*
!auto-ontology/.env.example

# Python cache & virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / Editor files
.DS_Store
Thumbs.db

# Upstream clone (pinned in config/freeze.yaml) and local tool state
/auto-ontology/
.superpowers/
