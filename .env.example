# ==============================================================================
# Auto-Ontology Lab — Environment Configuration (.env.example)
# Copy this file to .env and fill in the values for your environment:
#   cp .env.example .env
# ==============================================================================

# --- Step 1: `python -m lab clone` (Source & Target PostgreSQL) ---------------
# Option A (Shorthand CLI):
#   python -m lab clone postgres@localhost:5432/prod_db lms_synth
#   -> Only set LAB_SOURCE_PASSWORD / LAB_TARGET_PASSWORD below (if not in ~/.pgpass
#      or auto-ontology/.env).
#
# Option B (Full DSN in .env):
#   Set LAB_SOURCE_DSN and/or LAB_TARGET_DSN below, then run:
#   python -m lab clone lms_synth
LAB_SOURCE_DSN=
LAB_SOURCE_PASSWORD=

LAB_TARGET_DSN=
LAB_TARGET_PASSWORD=

# Password for the read-only `lab_ro` PostgreSQL role created on synthetic DBs
# (shared between `lab clone` and `lab import`, never written to dataset artefacts)
LAB_RO_PASSWORD=lab_ro

# --- Step 2+: `python -m lab doctor / import / ask` ---------------------------
# API tokens minted from the Auto-Ontology web UI (must start with `auto_ontology_`)
LAB_ADMIN_TOKEN=
LAB_VIEWER_TOKEN=
